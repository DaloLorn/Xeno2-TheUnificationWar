<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <!-- 
        Note for future reference: System.IO.Compression needs to be copied
        out of the game folder and into the SDK to suppress a conflict.
        This also necessitates a change to FrameworkList.xml to specify
        an AssemblyVersion of 4.2.0.0.
      -->
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>X2UnificationWar</RootNamespace>
        <LangVersion>latest</LangVersion>      
    </PropertyGroup>
      <ItemGroup>
        <ProjectReference Include="Xenonauts2.csproj" 
                    BuildReference="false" 
                    ReferenceOutputAssembly="false"
                    SkipGetTargetFrameworkProperties="true" />
        <!-- <None Include="$(Decompiled)\**\*.cs" Exclude="$(Decompiled)\bin\**;$(Decompiled)\obj\**;$(Decompiled)\tools\**" Link="DecompiledSource\%(RecursiveDir)%(Filename)%(Extension)"/> -->
        <Reference Include="0Harmony">
          <HintPath>$(GameFolder)\0Harmony.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Log4Net">
          <HintPath>$(GameFolder)\log4net.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
          <HintPath>$(GameFolder)\Assembly-CSharp.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Ink">
          <HintPath>$(GameFolder)\Ink-Libraries.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
          <HintPath>$(GameFolder)\Assembly-CSharp-firstpass.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Sirenix">
          <HintPath>$(GameFolder)\Sirenix.Serialization.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Sirenix">
          <HintPath>$(GameFolder)\Sirenix.Utilities.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Sirenix">
          <HintPath>$(GameFolder)\Sirenix.Serialization.Config.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="Sirenix">
          <HintPath>$(GameFolder)\Sirenix.OdinInspector.Attributes.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine">
          <HintPath>$(GameFolder)\UnityEngine.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.AudioModule">
          <HintPath>$(GameFolder)\UnityEngine.AudioModule.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
          <HintPath>$(GameFolder)\UnityEngine.CoreModule.dll</HintPath>
          <Private>False</Private>
        </Reference>
      </ItemGroup>

      <ItemGroup>
        <Content Include="X2-Unification-War.sln.DotSettings.user" />
      </ItemGroup>


      <!-- Copy the DLL (and PDB) after *every* build, no matter the config for easy mod debugging. -->
      <Target Name="CopyOutputToDepot" AfterTargets="Build">
        <ItemGroup>
          <BuiltArtifacts Include="$(TargetPath)" />
          <BuiltArtifacts Include="$(TargetDir)$(TargetName).pdb" />
        </ItemGroup>

        <Copy SourceFiles="@(BuiltArtifacts)" DestinationFolder="$(ModInstanceFolder)/assembly/common" SkipUnchangedFiles="true" />
      </Target>
</Project>
