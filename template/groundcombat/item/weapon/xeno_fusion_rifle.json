 Fusion Casters, but they cannot be upgraded further.","$t":"Description"},{"_min":0,"_val":85,"_max":3.402823e+38,"$t":"Damage"},{"_min":0,"_val":20,"_max":100,"$t":"ArmourPenetration"},{"_min":0,"_val":25,"_max":25,"$t":"ArmourDestruction"},{"_min":0,"_val":0.04,"_max":3.402823e+38,"$t":"LongRangeBonus"},{"_min":0,"_val":10,"_max":100,"$t":"BleedChance"},{"_min":0,"_val":3,"_max":100,"$t":"BleedWoundsInAttack"},{"_min":0,"_val":42,"_max":3.402823e+38,"$t":"SuppressionDamage"},{"$content":[{"Elements":[[1.0,{"Value":{"Parent":{"$content":"ST-::-item/weapon/xeno_fusion_rifle.json","$t":"ar_Template"},"_components":[{"_min":0,"_val":1,"_max":Infinity,"$t":"Quantity"}]},"$t":"0"}]]}],"$t":"RecoveredItems"},{"$content":"GC-::-ui/item/weapon/alien_fusion_rifle.png","$t":"Portrait"},{"value":"GC-::-item/weapon/alien_fusion_rifle.prefab","addColliders":false,"dontInstantiate":true,"pool":false,"$t":"Prototype"}],"$t":"4"},"$t":"15"}