{"version":"0.1.0","asset":{"Parent":{"$content":"$next-:-GC-::-item/weapon/alien_servitor_cannon.json","$t":"ar_Template"},"Name":"alien_gundrone_cannon","_components":[{"$content":[],"$t":"LocalizableGUID"},{"$content":"Plasma Cutter","$t":"Name"},{"$content":"GC-::-ui/item/weapon/alien_plasma_rifle.png","$t":"Portrait"},{"$content":[{"Prerequisite":{"Forward":"Slot","Delegate":{"Operator":"All","Number":0,"selector":{"OneComponent":"Xenonauts.Common.Components.Item.InventorySlotOwnerLink","$t":"OneEntitySe"},"prerequisites":[{"Species":{"&v":"servitor"},"Group":false,"Ethnicity":false,"Gender":false,"Variant":"Unlocks","modifierStorage":null,"$t":"BodyIDPq"},{"Target":"Xenonauts.Common.Components.Combatant.Rank","Compare":"Is","Value":{"$content":"servitor","$t":"Rank"},"UseInventoryType":false,"Variant":"Unlocks","modifierStorage":null,"$t":"DLEPq"}],"Variant":"Unlocks","modifierStorage":null,"$t":"ADelegatePq"},"Variant":"Unlocks","modifierStorage":null,"$t":"ForwardInventorySlotPq"},"Variant":"Unlocks","modifierStorage":null,"$t":"IgnoreInTestWrapperPq"}],"$t":"InventorySlotAddPrerequisites"},{"_min":0,"_val":20,"_max":3.402823e+38,"$t":"Damage"},{"_min":0,"_val":10,"_max":100,"$t":"ArmourPenetration"},{"_min":0,"_val":5,"_max":5,"$t":"ArmourDestruction"},{"_min":0,"_val":20,"_max":3.402823e+38,"$t":"SuppressionDamage"},{"$content":[{"FireMode":"burst","Trajectory":"Straight","NoMoveAccuracyBonus":false,"Ik":true,"ConsumesAmmo":false,"Shots":10,"ShotsDelay":0.1,"Name":"Burst Fire","AbsoluteCostTimeUnits":0,"PercentageCostTimeUnits":55,"ImportanceScale":1,"Crosshair":"GC-::-ui/crosshairs/crosshair_burst10","Accuracy":40,"Tooltip":false,"$t":"114"}],"$t":"GCAbilityDefinitions"},{"_min":0,"_val":5,"_max":3.402823e+38,"$t":"ShortRange"},{"_min":0,"_val":5,"_max":3.402823e+38,"$t":"LongRange"},{"_min":0,"_val":0.08,"_max":1,"$t":"ShortRangeBonus"},{"_min":0,"_val":0.2,"_max":3.402823e+38,"$t":"LongRangeBonus"},{"$content":"Originally intended as a utility tool to cut through inanimate objects comprised of anything up to and including hardened alien alloys, the Servitor's plasma cutter can double as a devastating short-range plasma weapon.\n\nPlasma cutters are a special kind of plasma weapon unique to the Servitor, featuring unlimited ammo and excellent suppression and anti-armor damage, at the cost of extremely low range, no overwatch capability, and low damage per hit.\n\nThis plasma cutter has a range dropoff of 20% (ballistics are 10%), and a 15% chance of starting a fire with each shot.","$t":"Description"}],"$t":"4"},"$t":"15"}